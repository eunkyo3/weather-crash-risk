# ============================================================
# weather-crash-risk 환경변수 예시
# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 절대 커밋되지 않습니다(.gitignore 처리됨).
# ============================================================

# --- 공공데이터포털 인증키 (KOROAD 다발지역 + 기상청 ASOS 공용) ---
# 발급: https://www.data.go.kr  로그인 > 마이페이지 > 인증키 발급/관리
# 아래 두 API 각각 "활용신청" 필요:
#   - 기상청_지상(종관, ASOS) 시간자료 조회서비스 (15057210)
#   - 한국도로교통공단_지자체별/보행자 교통사고 다발지역 (15057467 / 15105289)
# 포털이 주는 두 형태 중 "Decoding(일반 인증키)" 값을 넣으세요. requests가 인코딩합니다.
DATA_GO_KR_SERVICE_KEY=여기에_디코딩_인증키_붙여넣기

# --- 대상 지역/관측소 (서울) ---
TARGET_SIDO_CODE=11          # 서울특별시 시도 코드
TARGET_SIDO_NAME=서울특별시
ASOS_STATION_ID=108          # 서울 ASOS 지점번호

# --- 분석 기간 (사망사고 ~10년 누적) ---
START_YEAR=2014
END_YEAR=2023

# --- 핫스팟(다발지역) 유형 ---
# 보행자 우선. 전체로 폴백 시 frequentzoneLg 로 교체.
# 보행자 op 정확한 이름은 15105289 상세페이지 "요청주소"에서 확인 후 교체.
KOROAD_HOTSPOT_OP=frequentzoneLg

# --- 수집 동작(호출 최적화) ---
REQUEST_TIMEOUT=20
MAX_RETRIES=5
RATE_LIMIT_SLEEP=0.34        # 초당 ~3회 (개발계정 일 10,000회 제한 여유)
RAW_DIR=data/raw
CACHE_DIR=data/cache

# --- PostGIS (Docker Compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_crash
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
